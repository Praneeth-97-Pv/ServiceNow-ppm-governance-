# ServiceNow PDI connection — copy this file to `.env` and fill it in.
# `.env` holds your password; it is gitignored and never leaves your machine.

# Your PDI URL. Accepts "dev12345", "dev12345.service-now.com", or the full https:// URL.
SERVICENOW_INSTANCE_URL=dev12345

# PDI admin credentials (Developer portal → Manage instance → shows the admin password).
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# --- optional ---

# true  = expose only the read tools (query/get/aggregate/describe)
# false = also allow create, update, delete and background scripts
SERVICENOW_READ_ONLY=false

# Set to false to hide the background-script tool even when writes are allowed.
SERVICENOW_ALLOW_SCRIPTS=true

# Truncate any single tool response longer than this many characters.
SERVICENOW_MAX_RESPONSE_CHARS=40000

# Per-request timeout in milliseconds.
SERVICENOW_TIMEOUT_MS=60000
